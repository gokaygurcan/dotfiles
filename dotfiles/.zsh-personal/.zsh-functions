# weather amsterdam
weather () {
  curl http://wttr\.in/$1
}

# find pid that is listening to the port
ppid() {
  lsof -n -i4TCP:$1 | grep LISTEN
}

# mkdir + cd
mk() {
  mkdir -p "$1" && cd "$1"
}

# update brew and global npm packages
update() {
  # update global node packages
  bun update -g

  # update/upgrade brew packages
  brew update
  brew upgrade
  brew cleanup
}
